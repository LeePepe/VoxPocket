# VoxPocket TestFlight 自动发布 lane（复刻 VitalStride 模式）。
#
# 由 .github/workflows/testflight.yml 在 self-hosted runner 上调用。
# 全程走 App Store Connect API Key（.p8），无需 Apple ID / 2FA。
#
# 需要的环境变量（workflow 从 GitHub Secrets 注入）：
#   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_P8_BASE64
#
# 签名：manual + App Store distribution profile（fastlane 自动为付费 team 拉取）。
# 不用 automatic —— runner 钥匙串含多个 Apple 账号的证书，automatic 在 archive
# 阶段给每个 target 解析 Development 证书，但付费 team 4Z8GG667QD 只有 Distribution、
# 无 Development → automatic 回退误挑别账号的 Development 证书 → errSecInternalComponent。
# 改 manual：用 get_provisioning_profile 拉 bundleID 的 App Store profile，
# build_app 显式映射（profile 名在 project.yml 的 Release config 里指定）。
#
# 项目结构差异（vs VitalStride）：project.yml 在 VoxPocket/ 子目录，不是 repo 根；
# .xcodeproj 也在 VoxPocket/。fastlane 从 repo 根运行，故路径都带 VoxPocket/ 前缀。

require "base64"

default_platform(:ios)

APP_IDENTIFIER = "com.leepepe.voxpocket".freeze
WIDGET_IDENTIFIER = "com.leepepe.voxpocket.widget".freeze
SCHEME = "VoxPocket".freeze
XCODEPROJ = "VoxPocket/VoxPocket.xcodeproj".freeze
TEAM_ID = "4Z8GG667QD".freeze
MARKETING_VERSION = "1.0".freeze

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
    is_key_content_base64: true,
    in_house: false
  )
end

# project.yml 在 VoxPocket/ 子目录；fastlane 工作目录是 fastlane/，故 ../VoxPocket。
def regenerate_project
  sh("cd ../VoxPocket && xcodegen generate")
end

# Build number 必须**全局单调递增**（跨 marketing version、跨平台不重置）。
# 去掉 version: 后查该 app 所有版本的最大 build +1，避免 bump marketing version
# 后 build 从 1 重置被 ASC 判为旧构建。
def next_build_number(api_key)
  latest = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    initial_build_number: 0
  )
  nb = latest.to_i + 1
  UI.message("TestFlight latest build (all versions/platforms) = #{latest}; this build = #{nb}")
  nb
end

# 上传后用 spaceship 显式把 build 加到 internal 群组（默认 "Internal"，可用
# TESTFLIGHT_GROUPS 覆盖）。绕开 upload_to_testflight `groups:` 对 internal 无效的坑。
# 容错：分发失败不让整个 lane 挂（binary 已上传），除非 TESTFLIGHT_STRICT_UPLOAD=1。
def distribute_to_internal(next_build, platform_sym)
  tf_group_names = ENV.fetch("TESTFLIGHT_GROUPS", "Internal")
                      .split(",").map(&:strip).reject(&:empty?)
  begin
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key: Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64"))
    )
    asc_app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    build = Spaceship::ConnectAPI::Build.all(
      app_id: asc_app.id,
      version: MARKETING_VERSION,
      build_number: next_build.to_s
    ).first
    UI.user_error!("Uploaded build #{MARKETING_VERSION}(#{next_build}) not found in ASC for distribution") if build.nil?

    all_groups = asc_app.get_beta_groups
    tf_group_names.each do |gname|
      grp = all_groups.find { |g| g.name == gname }
      if grp.nil?
        UI.important("Beta group '#{gname}' not found in ASC — skipping (check exact name, case-sensitive).")
        next
      end
      build.add_beta_groups(beta_groups: [grp])
      UI.success("Distributed #{platform_sym} build #{MARKETING_VERSION}(#{next_build}) to group '#{gname}'.")
    end
  rescue => e
    UI.error("Internal-group distribution failed: #{e.message}")
    UI.important("Binary upload succeeded; the build is in TestFlight but not distributed — add it manually or re-run.")
    raise e if ENV["TESTFLIGHT_STRICT_UPLOAD"] == "1"
  end
end

platform :ios do
  desc "Build and upload an iOS build to TestFlight (internal testing)"
  lane :beta do
    api_key = asc_api_key
    regenerate_project
    next_build = next_build_number(api_key)

    # 为 app + widget 拉 App Store distribution profile（付费 team）。
    # provisioning_name 显式指定名字，与 project.yml 的 PROVISIONING_PROFILE_SPECIFIER 一致
    # （否则 fastlane 自动生成 "<bundleid> AppStore"，与 project.yml 的人起名字对不上 → archive 找不到 profile）。
    # 需要时自动在 Developer Portal 以该名字创建。
    app_profile = get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      team_id: TEAM_ID,
      platform: "ios",
      provisioning_name: "VoxPocket App Store",
      skip_install: false
    )
    widget_profile = get_provisioning_profile(
      api_key: api_key,
      app_identifier: WIDGET_IDENTIFIER,
      team_id: TEAM_ID,
      platform: "ios",
      provisioning_name: "VoxPocket Widget App Store",
      skip_install: false
    )

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      export_team_id: TEAM_ID,
      # 只注入 build number + team；签名走 project.yml Release config 的 Manual +
      # 各 target 的 PROVISIONING_PROFILE_SPECIFIER（profile 已由上面拉取安装）。
      xcargs: "CURRENT_PROJECT_VERSION=#{next_build} DEVELOPMENT_TEAM=#{TEAM_ID}",
      export_options: {
        manageAppVersionAndBuildNumber: false,
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: {
          APP_IDENTIFIER => ENV.fetch("sigh_#{APP_IDENTIFIER}_appstore_profile-name", app_profile),
          WIDGET_IDENTIFIER => ENV.fetch("sigh_#{WIDGET_IDENTIFIER}_appstore_profile-name", widget_profile)
        }
      },
      output_directory: ENV.fetch("RUNNER_TEMP", "/tmp"),
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: false,
      skip_submission: true,
      distribute_external: false
    )

    distribute_to_internal(next_build, :ios)
  end
end

platform :mac do
  desc "Build and upload a macOS build to TestFlight (internal testing)"
  lane :beta do
    api_key = asc_api_key
    regenerate_project
    next_build = next_build_number(api_key)

    # macOS 只有主 app（无 widget，widget 仅 iOS）。拉 macOS App Store profile。
    # provisioning_name 与 project.yml 的 macosx specifier 一致。
    app_profile = get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      team_id: TEAM_ID,
      platform: "macos",
      provisioning_name: "VoxPocket Mac App Store",
      skip_install: false
    )

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=macOS",
      export_method: "app-store",
      export_team_id: TEAM_ID,
      xcargs: "CURRENT_PROJECT_VERSION=#{next_build} DEVELOPMENT_TEAM=#{TEAM_ID}",
      export_options: {
        manageAppVersionAndBuildNumber: false,
        signingStyle: "manual",
        teamID: TEAM_ID,
        # macOS App Store 的 .pkg 用 installer 证书签名。不显式指定时 xcodebuild
        # 会去 provisioning profile 里找 installer 证书、找不到就报
        # "Provisioning profile ... doesn't include signing certificate
        # '3rd Party Mac Developer Installer'" → export 失败(IPA invalid)。
        # 显式指定钥匙串里的 installer 证书即可(profile 本不含 installer 证书)。
        installerSigningCertificate: "3rd Party Mac Developer Installer: Tianpei Li (4Z8GG667QD)",
        provisioningProfiles: {
          APP_IDENTIFIER => ENV.fetch("sigh_#{APP_IDENTIFIER}_appstore_profile-name", app_profile)
        }
      },
      output_directory: ENV.fetch("RUNNER_TEMP", "/tmp"),
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: false,
      skip_submission: true,
      distribute_external: false
    )

    distribute_to_internal(next_build, :mac)
  end
end
