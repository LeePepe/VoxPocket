# VoxPocket TestFlight 自动发布 lane（复刻 VitalStride 模式）。
#
# 由 .github/workflows/testflight.yml 在 self-hosted runner 上调用。
# 全程走 App Store Connect API Key（.p8），无需 Apple ID / 2FA。
#
# 需要的环境变量（workflow 从 GitHub Secrets 注入）：
#   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_P8_BASE64
#
# 签名：manual + App Store distribution profile（fastlane 自动为付费 team 拉取）。
# 不用 automatic —— runner 钥匙串含多个 Apple 账号的证书，automatic 在 archive
# 阶段给每个 target 解析 Development 证书，但付费 team 4Z8GG667QD 只有 Distribution、
# 无 Development → automatic 回退误挑别账号的 Development 证书 → errSecInternalComponent。
# 改 manual：用 get_provisioning_profile 拉 bundleID 的 App Store profile，
# build_app 显式映射（macOS 通过 VOXPOCKET_MAC_PROFILE_SPECIFIER 在当前运行动态注入）。
#
# 项目结构差异（vs VitalStride）：project.yml 在 VoxPocket/ 子目录，不是 repo 根；
# .xcodeproj 也在 VoxPocket/。fastlane 从 repo 根运行，故路径都带 VoxPocket/ 前缀。

require "shellwords"

default_platform(:ios)

APP_IDENTIFIER = "com.leepepe.voxpocket".freeze
WIDGET_IDENTIFIER = "com.leepepe.voxpocket.widget".freeze
SCHEME = "VoxPocket".freeze
XCODEPROJ = "VoxPocket/VoxPocket.xcodeproj".freeze
TEAM_ID = "4Z8GG667QD".freeze
MARKETING_VERSION = "1.0".freeze

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
    is_key_content_base64: true,
    in_house: false
  )
end

# project.yml 在 VoxPocket/ 子目录；fastlane 工作目录是 fastlane/，故 ../VoxPocket。
def regenerate_project
  sh("cd ../VoxPocket && xcodegen generate")
end

# Build number 按目标平台递增，跨 marketing version 不重置。
# macOS 必须显式查询 osx；iOS 暂停后不能继续用默认 iOS 计数，否则 macOS 会重复用号。
def next_build_number(api_key, platform: "ios")
  latest = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    platform: platform,
    initial_build_number: 0
  )
  nb = latest.to_i + 1
  UI.message("TestFlight latest build (#{platform}, all versions) = #{latest}; this build = #{nb}")
  nb
end

# 仅接收 runner-temp 文件路径；不读取配置内容，也不将值拼入可打印参数。
def with_telemetry_xcconfig
  path = ENV["TELEMETRY_XCCONFIG_PATH"].to_s
  temp = ENV["RUNNER_TEMP"].to_s
  unless !path.empty? && !temp.empty? && File.directory?(temp) &&
         File.realpath(File.dirname(File.expand_path(path))) == File.realpath(temp) && !File.symlink?(path) && File.file?(path)
    UI.user_error!("Telemetry xcconfig must be a regular runner-temp file")
  end
  unless File.stat(path).uid == Process.uid
    UI.user_error!("Telemetry xcconfig must belong to the runner")
  end
  begin
    unless (File.stat(path).mode & 0o7777) == 0o600
      UI.user_error!("Telemetry xcconfig must have mode 0600")
    end
    yield path
  ensure
    File.delete(path) if File.exist?(path)
  end
end

# lane 只上传并等待 Apple 处理；测试组分发由 App Store Connect 的配置管理。

platform :ios do
  desc "Build and upload an iOS build to TestFlight (internal testing)"
  lane :beta do
    api_key = asc_api_key
    regenerate_project
    next_build = next_build_number(api_key)

    # 为 app + widget 拉 App Store distribution profile（付费 team）。
    # provisioning_name 显式指定名字，与 project.yml 的 PROVISIONING_PROFILE_SPECIFIER 一致
    # （否则 fastlane 自动生成 "<bundleid> AppStore"，与 project.yml 的人起名字对不上 → archive 找不到 profile）。
    # 需要时自动在 Developer Portal 以该名字创建。
    app_profile = get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      team_id: TEAM_ID,
      platform: "ios",
      provisioning_name: "VoxPocket App Store",
      skip_install: false
    )
    widget_profile = get_provisioning_profile(
      api_key: api_key,
      app_identifier: WIDGET_IDENTIFIER,
      team_id: TEAM_ID,
      platform: "ios",
      provisioning_name: "VoxPocket Widget App Store",
      skip_install: false
    )

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      export_team_id: TEAM_ID,
      # 只注入 build number + team；签名走 project.yml Release config 的 Manual +
      # 各 target 的 PROVISIONING_PROFILE_SPECIFIER（profile 已由上面拉取安装）。
      xcargs: "CURRENT_PROJECT_VERSION=#{next_build} DEVELOPMENT_TEAM=#{TEAM_ID}",
      export_options: {
        manageAppVersionAndBuildNumber: false,
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: {
          APP_IDENTIFIER => ENV.fetch("sigh_#{APP_IDENTIFIER}_appstore_profile-name", app_profile),
          WIDGET_IDENTIFIER => ENV.fetch("sigh_#{WIDGET_IDENTIFIER}_appstore_profile-name", widget_profile)
        }
      },
      output_directory: ENV.fetch("RUNNER_TEMP", "/tmp"),
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: false,
      skip_submission: true,
      distribute_external: false
    )
  end
end

platform :mac do
  desc "Build and upload a macOS build to TestFlight (internal testing)"
  lane :beta do
    with_telemetry_xcconfig do |telemetry_xcconfig|
      api_key = asc_api_key
      regenerate_project
      next_build = next_build_number(api_key, platform: "osx")

      # macOS 只有主 app（无 widget，widget 仅 iOS）。拉取/创建并安装当前运行适用的 macOS App Store profile。
      # force: true 确保拉取最新可用 profile，不指定固定 provisioning_name。
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER,
        team_id: TEAM_ID,
        platform: "macos",
        force: true,
        skip_install: false
      )

      profile_name = lane_context[SharedValues::SIGH_NAME]
      if profile_name.to_s.strip.empty?
        UI.user_error!("macOS provisioning profile name for #{APP_IDENTIFIER} could not be determined from App Store Connect output; refusing archive")
      end

      escaped_profile = Shellwords.escape(profile_name)

      pkg_path = build_app(
        project: XCODEPROJ,
        scheme: SCHEME,
        configuration: "Release",
        destination: "generic/platform=macOS",
        # gym 对多平台 target 按 sdk 选择 PKG/IPA；destination 本身不足以选中 PKG。
        sdk: "macosx",
        # 仅 archive 使用此命令；xcconfig 选项还会传给可打印的依赖解析/设置检测。
        # 在 tee/formatter 前丢弃两路输出，失败或 verbose 时也不能重放配置值。
        xcodebuild_command: "xcodebuild -xcconfig #{Shellwords.escape(telemetry_xcconfig)} > /dev/null 2>&1",
        suppress_xcode_output: true,
        export_method: "app-store",
        export_team_id: TEAM_ID,
        xcargs: "-quiet CURRENT_PROJECT_VERSION=#{next_build} DEVELOPMENT_TEAM=#{TEAM_ID} VOXPOCKET_MAC_PROFILE_SPECIFIER=#{escaped_profile}",
        export_options: {
          manageAppVersionAndBuildNumber: false,
          signingStyle: "manual",
          teamID: TEAM_ID,
          # macOS App Store 的 .pkg 用 installer 证书签名。使用通用选择器 Mac Installer Distribution。
          installerSigningCertificate: "Mac Installer Distribution",
          provisioningProfiles: {
            APP_IDENTIFIER => profile_name
          }
        },
        output_directory: ENV.fetch("RUNNER_TEMP", "/tmp"),
        clean: true
      )

      unless pkg_path && File.extname(pkg_path) == ".pkg" && File.file?(pkg_path)
        UI.user_error!("macOS export did not produce the expected .pkg; refusing TestFlight upload")
      end

      upload_to_testflight(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER,
        app_platform: "osx",
        pkg: pkg_path,
        skip_waiting_for_build_processing: false,
        skip_submission: true,
        distribute_external: false
      )
    end
  end
end
