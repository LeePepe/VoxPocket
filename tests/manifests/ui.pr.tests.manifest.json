{
  "suiteId": "ui.pr",
  "owner": {
    "agent": "ui-test-improver",
    "team": "ui-tests"
  },
  "entry": {
    "command": "xcodebuild test -project VoxPocket/VoxPocket.xcodeproj -scheme VoxPocket -destination 'platform=macOS' -only-testing:VoxPocketUITests/VoxPocketUITests/testExample",
    "timeoutSeconds": 1200
  },
  "labels": [
    "pr"
  ],
  "dependencies": [
    "zsh",
    "jq"
  ],
  "flakyPolicy": {
    "allowRetry": true,
    "maxRetries": 1,
    "quarantineAfterConsecutiveFailures": 3
  },
  "artifactsContract": {
    "required": [
      "logs/test.log"
    ],
    "optional": [],
    "retentionDays": 14
  }
}
