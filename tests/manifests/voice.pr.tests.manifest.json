{
  "suiteId": "voice.pr",
  "owner": {
    "agent": "voice-test-improver",
    "team": "voice-tests"
  },
  "entry": {
    "command": "swift test --package-path Packages/VoxInfrastructure --filter TranscriptionKitTests",
    "timeoutSeconds": 1200
  },
  "labels": [
    "pr"
  ],
  "dependencies": [
    "zsh",
    "jq"
  ],
  "flakyPolicy": {
    "allowRetry": true,
    "maxRetries": 1,
    "quarantineAfterConsecutiveFailures": 3
  },
  "artifactsContract": {
    "required": [
      "logs/test.log"
    ],
    "optional": [],
    "retentionDays": 14
  }
}
