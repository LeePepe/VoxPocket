# Worktrees
.worktrees/

# macOS
.DS_Store

# Swift/Xcode
.build/
build/
/VoxPocket/build/
/Packages/*/build/
.swiftpm/
**/*.xcodeproj/xcuserdata/
**/*.xcworkspace/xcuserdata/
**/*.xcodeproj/project.xcworkspace/xcuserdata/
*.backup
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/
Package.resolved

# Archives
*.zip

# Local CI/CD outputs
releases/
.release-staging/

# Test executor artifacts
artifacts/reports/
artifacts/suites/

# CSV files (可能是临时数据)
*.csv

# Personal developer hooks (each contributor sets up their own)
.github/hooks/

# Claude Code local settings
.claude/settings.local.json

# Local secrets (API keys injected via xcconfig). Config.xcconfig is committed;
# Secrets.xcconfig holds real values and must never be committed.
Secrets.xcconfig
**/Secrets.xcconfig

# Fastlane / TestFlight 发布产物与密钥（绝不提交）
AuthKey_*.p8            # App Store Connect API key，仅本地/CI secret
*.pkg                  # macOS 打包产物
*.mobileprovision      # sigh 下载的 provisioning profile
AppStore_*.mobileprovision
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
fastlane/README.md

