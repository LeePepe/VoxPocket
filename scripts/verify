#!/usr/bin/env bash
# VoxPocket single verification entry, shared by .githooks/pre-push and CI.
#
#   scripts/verify              changed layers vs $VERIFY_BASE (default origin/main)
#   scripts/verify --changed    same as the default
#   scripts/verify --all        every layer gate + policy
#   scripts/verify --policy     repository policy checks only (CI "Lint & policy")
#   scripts/verify --layer L    one layer's gates (CI "SPM <pkg>" / App target lanes)
#
# Layer selection and gates come from the tech-context layer map through the
# shared-ci resolver pinned in AGENTS.md ($SHARED_CI, default .shared-ci).
# The pre-existing deterministic push checks run unchanged through
# scripts/gates/gate-prepush.sh. Heavy xcodebuild stays in CI unless RUN_HEAVY=1.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"
# Git hooks export GIT_DIR (and friends) for this repository. Drop them so every git
# command below, in particular the .shared-ci init/fetch, targets its own directory
# and never reinitialises or fetches into the caller's repository.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX

mode="changed"
layer=""
case "${1:-}" in
    ""|--changed) mode="changed" ;;
    --all) mode="all" ;;
    --policy) mode="policy" ;;
    --layer) mode="layer"; layer="${2:?--layer needs a layer name}" ;;
    -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
    *) echo "[verify] unknown option: $1 (use --changed, --all, --policy or --layer L)" >&2; exit 2 ;;
esac

# ---- shared-ci resolver at the pinned SHA -----------------------------------
shared_ci="${SHARED_CI:-$root/.shared-ci}"
pin="$(sed -n 's|.*LeePepe/shared-ci@\([0-9a-f]\{40\}\)/ai/agent-protocol\.md.*|\1|p' AGENTS.md | head -1)"
[ -n "$pin" ] || { echo "[verify] AGENTS.md has no full-SHA shared-ci protocol pointer" >&2; exit 1; }
if [ "$(git -C "$shared_ci" rev-parse HEAD 2>/dev/null || true)" != "$pin" ]; then
    rm -rf "$shared_ci"
    git init -q "$shared_ci"
    git -C "$shared_ci" fetch -q --depth=1 "${SHARED_CI_URL:-https://github.com/LeePepe/shared-ci.git}" "$pin" \
        || { echo "[verify] cannot fetch shared-ci $pin" >&2; exit 1; }
    git -C "$shared_ci" checkout -q --detach FETCH_HEAD
fi
context=(python3 "$shared_ci/scripts/context/_context.py")

# ---- repository policy (was CI "Lint & policy" + hook checks) ---------------
policy() {
    echo "[verify] policy"
    "${context[@]}" audit >/dev/null
    python3 "$shared_ci/scripts/lint/workflows.py" --root . >/dev/null
    python3 scripts/gates/check_private_config.py
    python3 scripts/gates/check_frontmatter.py
    python3 -m unittest discover -s scripts/gates/tests -p 'test_*.py'
    python3 scripts/ci/tests/test_review_prompt.py
    python3 scripts/ci/tests/test_review_raven.py
    bash scripts/ci/kimi-review.contract.test.sh
    python3 scripts/tests/test_testflight_schedule.py
    if command -v gitleaks >/dev/null 2>&1; then
        gitleaks detect --no-banner --config .gitleaks.toml --redact
    elif [ "${VERIFY_MODE:-}" = "ci" ]; then
        echo "[verify] gitleaks is required in CI" >&2; exit 1
    else
        echo "[verify] gitleaks not installed; secret scan left to CI"
    fi
    no_transcript_in_logs
}

# Privacy (constitution IV): transcript/refined text must never reach logs.
no_transcript_in_logs() {
    local matches
    matches="$(grep -rnE '(os_log|Logger|print|NSLog|log\.(debug|info|error|warning))[^"]*"[^"]*\\\((refinedText|rawTranscription|liveTranscription|transcript|refined|displayText)' \
        --include='*.swift' Packages VoxPocket 2>/dev/null | grep -v '/\.build/' || true)"
    if [ -n "$matches" ]; then
        echo "Blocked: 转写/精炼文本不得进日志（隐私，宪法 IV）：" >&2
        echo "$matches" >&2
        exit 1
    fi
}

run_layer() {
    local gate_mode="local"
    [ "${VERIFY_MODE:-}" = "ci" ] && gate_mode="ci"
    "${context[@]}" run "$1" --mode "$gate_mode"
}

heavy_app_build() {
    [ "${RUN_HEAVY:-0}" = "1" ] || return 0
    echo "[verify] RUN_HEAVY=1 — local macOS app build (normally CI only)"
    xcodebuild -project VoxPocket/VoxPocket.xcodeproj -scheme VoxPocket -destination 'platform=macOS' \
        CODE_SIGN_IDENTITY="" CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO build >/tmp/verify-heavy.log 2>&1 \
        || { echo "[verify] heavy build failed"; tail -40 /tmp/verify-heavy.log; exit 1; }
}

case "$mode" in
    policy) policy; echo "[verify] ok: policy"; exit 0 ;;
    layer) run_layer "$layer"; echo "[verify] ok: $layer"; exit 0 ;;
    all)
        policy
        layers="$("${context[@]}" layers --all)"
        for name in $layers; do run_layer "$name"; done
        heavy_app_build
        echo "[verify] ok: all layers ($(echo $layers | tr '\n' ' '))"
        exit 0 ;;
esac

# ---- changed mode (what .githooks/pre-push runs) ------------------------------
# Contract audit + workflow-lint + the existing deterministic push gate
# (scripts/gates/gate-prepush.sh: private config guard, frontmatter anti-rot,
# changed-source-needs-tests, docs-only shortcut, fast swift test per changed
# package), then resolver-selected gates for changed layers outside Packages/.
"${context[@]}" audit >/dev/null
python3 "$shared_ci/scripts/lint/workflows.py" --root . >/dev/null
bash scripts/gates/gate-prepush.sh

base="$(git merge-base "${VERIFY_BASE:-origin/main}" HEAD)"
changed="$(git diff --name-only "$base" HEAD)"
[ -n "$changed" ] || exit 0
layers="$(printf '%s\n' "$changed" | "${context[@]}" layers --stdin)"
for name in $layers; do
    [ -d "Packages/$name" ] && continue # already tested by gate-prepush.sh
    run_layer "$name"
done
case " $(echo $layers) " in *" VoxPocketApp "*) heavy_app_build ;; esac
echo "[verify] ok: changed layers: $(echo ${layers:-none})"
